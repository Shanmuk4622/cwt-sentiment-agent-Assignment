# ==============================================================================
# CrowdWisdomTrading X Sentiment Price Prediction Agent - Environment Config
# ==============================================================================
# Copy this file to .env and insert your API credentials.
# The pipeline is also equipped with offline fallbacks and synthetic generators
# if credentials are not provided or if rate limits are reached.

# ------------------------------------------------------------------------------
# 1. APIFY (X / Twitter Scraper)
# ------------------------------------------------------------------------------
# Obtain your API token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Apify Actor ID for X scraping. Default: apidojo/tweet-scraper
# Popular alternatives:
# - apidojo/tweet-scraper (Recommended for high-volume cashtag searches)
# - quacker/twitter-scraper
APIFY_TWITTER_ACTOR_ID=apidojo/tweet-scraper

# ------------------------------------------------------------------------------
# 2. TAVILY (Primary News Search & Ingestion)
# ------------------------------------------------------------------------------
# Obtain your API key from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. EXA (Alternative News & Web Intelligence)
# ------------------------------------------------------------------------------
# Obtain your API key from: https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# ------------------------------------------------------------------------------
# 4. Target Asset & Pipeline Settings
# ------------------------------------------------------------------------------
TARGET_ASSET=BTC-USD
DEFAULT_BAR_INTERVAL=1h
DAYS_HISTORY=180
DEVICE=cuda
